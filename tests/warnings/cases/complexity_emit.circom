pragma circom 2.1.4;
template Main() {
    signal input in;
    signal output out;
    var value = 0;
    if (in == 0) {
        value = 0;
    }
    if (in == 1) {
        value = 1;
    }
    if (in == 2) {
        value = 2;
    }
    if (in == 3) {
        value = 3;
    }
    if (in == 4) {
        value = 4;
    }
    if (in == 5) {
        value = 5;
    }
    if (in == 6) {
        value = 6;
    }
    if (in == 7) {
        value = 7;
    }
    if (in == 8) {
        value = 8;
    }
    if (in == 9) {
        value = 9;
    }
    if (in == 10) {
        value = 10;
    }
    if (in == 11) {
        value = 11;
    }
    if (in == 12) {
        value = 12;
    }
    if (in == 13) {
        value = 13;
    }
    if (in == 14) {
        value = 14;
    }
    if (in == 15) {
        value = 15;
    }
    if (in == 16) {
        value = 16;
    }
    if (in == 17) {
        value = 17;
    }
    if (in == 18) {
        value = 18;
    }
    if (in == 19) {
        value = 19;
    }
    if (in == 20) {
        value = 20;
    }
    if (in == 21) {
        value = 21;
    }
    out <-- value;
}
component main = Main();
